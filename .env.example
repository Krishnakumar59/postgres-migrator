# ==============================================================================
# PG-Migrator Configuration Template
# ==============================================================================

# 1. Current Production Database (Source - STRICTLY READ-ONLY)
CURRENT_PRODUCTION_DB_URL=postgres://username:password@your-production-db-host:5432/production_db?sslmode=require

# 2. New Destination Database (Target - Empty Database on New Provider)
NEW_DATABASE_URL=postgres://username:password@your-new-db-host:5432/new_db?sslmode=require

# ------------------------------------------------------------------------------
# (Optional) Multi-Channel Real-Time Notifications
# ------------------------------------------------------------------------------

# Discord Webhook URL (supports rich embedded color cards)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Slack Webhook URL (supports Block Kit formatting)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Telegram Bot Alerts (instant mobile notifications)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Generic Webhook URL fallback (if not using Discord/Slack specific URL)
# MIGRATION_WEBHOOK_URL=https://your-custom-webhook-endpoint.com
